{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mathscape",
  "version": "0.1.0",
  "identifier": "com.mathscape.desktop",
  "build": {
    "beforeDevCommand": "cargo build -p mathscape-cli && npm --prefix ../frontend run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo build -p mathscape-cli --release && npm --prefix ../frontend run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mathscape",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
