{
  "name": "mathscape-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:reader": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "tauri:dev": "cd ../apps/mathscape-desktop && ../../frontend/node_modules/.bin/tauri dev",
    "tauri:dev:local_1": "cd ../apps/mathscape-desktop && MATHSCAPE_WORKSPACE_ROOT=\"$PWD/../../.mathscape-dev/workspace\" ../../frontend/node_modules/.bin/tauri dev",
    "tauri:dev:local_2": "cd ../apps/mathscape-desktop && MATHSCAPE_WORKSPACE_ROOT=\"$PWD/../../.mathscape-dev/workspace2\" ../../frontend/node_modules/.bin/tauri dev",
    "tauri:build": "cd ../apps/mathscape-desktop && ../../frontend/node_modules/.bin/tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "cytoscape": "3.34.2",
    "katex": "0.18.6",
    "markdown-it": "14.3.1",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "^5.0.2"
  }
}
