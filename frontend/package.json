{
  "name": "mathscape-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run pad:build && vite --host 127.0.0.1 --port 1420",
    "dev:test": "npm run pad:build && vite --host 127.0.0.1",
    "build": "tsc --noEmit && npm run pad:build && vite build",
    "typecheck": "tsc --noEmit",
    "test:reader": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "tauri:dev": "cd ../apps/mathscape-desktop && node ../../frontend/node_modules/@tauri-apps/cli/tauri.js dev",
    "tauri:dev:local_1": "cd ../apps/mathscape-desktop && MATHSCAPE_WORKSPACE_ROOT=\"$PWD/../../.mathscape-dev/workspace\" ../../frontend/node_modules/.bin/tauri dev",
    "tauri:dev:local_2": "cd ../apps/mathscape-desktop && MATHSCAPE_WORKSPACE_ROOT=\"$PWD/../../.mathscape-dev/workspace2\" ../../frontend/node_modules/.bin/tauri dev",
    "tauri:build": "cd ../apps/mathscape-desktop && node ../../frontend/node_modules/@tauri-apps/cli/tauri.js build",
    "ink:build": "tsc --noEmit && vite build --config vite.ink.config.ts && vite build --config vite.ink.config.ts --mode contract",
    "ink:lab": "npm run ink:build && node scripts/ink-lab-server.mjs",
    "test:ink-server": "npm run ink:build && node --test tests/ink-server.test.mjs",
    "test:ink-browser": "npm run ink:build && playwright test --config playwright.ink.config.ts",
    "pad:build": "vite build --config vite.pad.config.ts",
    "test:pad-browser": "playwright test --config playwright.pad.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "cytoscape": "3.34.2",
    "katex": "0.18.6",
    "markdown-it": "14.3.3",
    "pdfjs-dist": "6.3.289",
    "perfect-freehand": "1.2.3",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/qrcode": "1.5.6",
    "typescript": "7.0.2",
    "vite": "8.2.4",
    "vitest": "^5.0.2"
  }
}
